# Copy to .env with `cp .env.example .env`. .env is gitignored: never commit real keys.

# Postgres with pgvector, started by `make up`
POSTGRES_USER=chiral
POSTGRES_PASSWORD=chiral
POSTGRES_DB=chiral
POSTGRES_PORT=5432
# Keep in sync with the four values above
DATABASE_URL=postgresql://chiral:chiral@localhost:5432/chiral

# Redis, started by `make up`
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Claude API (used from Phase 3)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
